RunService:BindToRenderStep("MyMouseAimLoop", Enum.RenderPriority.Last.Value, function()
    if isAimbotActive and silentAimTarget and silentAimTarget:FindFirstChild(currentAimPartName) then
        local aimPartPos = silentAimTarget[currentAimPartName].Position
        local targetPos, onScreen = Camera:WorldToViewportPoint(aimPartPos)
        if onScreen then
            if mousemoverel then
                local center = Camera.ViewportSize / 2
                local moveX = (targetPos.X - center.X) / AIM_SMOOTHNESS; local moveY = (targetPos.Y - center.Y) / AIM_SMOOTHNESS
