local function updateXray(state)
    Config.isXray = state
    if state then
        task.spawn(function()
            local count = 0
            local parts = workspace:GetDescendants()
            for i = 1, #parts do
                if not Config.isXray then return end
                local obj = parts[i]
                if obj:IsA("BasePart") and not obj.Parent:FindFirstChild("Humanoid") and obj.Name ~= "HumanoidRootPart" then
                    if State.originalTransparencies[obj] == nil then State.originalTransparencies[obj] = obj.Transparency end
                    obj.Transparency = 0.5
                end
                count = count + 1
                if count % 800 == 0 then task.wait() end
            end
        end)
        State.xrayConnection = workspace.DescendantAdded:Connect(function(obj)
            if Config.isXray and obj:IsA("BasePart") and not obj.Parent:FindFirstChild("Humanoid") and obj.Name ~= "HumanoidRootPart" then
                task.wait(0.1)
                if State.originalTransparencies[obj] == nil then State.originalTransparencies[obj] = obj.Transparency end
                obj.Transparency = 0.5
            end
        end)
    else
        if State.xrayConnection then State.xrayConnection:Disconnect(); State.xrayConnection = nil end
        task.spawn(function()
            local count = 0
            for obj, trans in pairs(State.originalTransparencies) do
                if Config.isXray then return end
                if obj and obj.Parent then obj.Transparency = trans end
                count = count + 1
                if count % 800 == 0 then task.wait() end
            end
            State.originalTransparencies = {}
        end)
    end
end
