        local U = require(ReplicatedStorage:WaitForChild("Modules", 5):WaitForChild("Utility"))
        local G = require(GM)
        _G.WallbangSys = {Active = false, Target = nil, Desyncing = false, HBC = nil, DSC = nil, Old = G.StartShooting}
        
        G.StartShooting = function(gun, ...)
            local r = {_G.WallbangSys.Old(gun, ...)}
            if not Config.isWallbang then return unpack(r) end
            if not (gun.ClientFighter and gun.ClientFighter.IsLocalPlayer) then return unpack(r) end
            local d = r[3]; if not d or typeof(d) ~= "table" then return unpack(r) end
            r[4] = true
