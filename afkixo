local function FindGroundBelow(point)
    local rayParams = RaycastParams.new()
    rayParams.IgnoreWater = true
    local downRay = workspace:Raycast(point + Vector3.new(0, 5, 0), Vector3.new(0, -20, 0), rayParams)
    if downRay and (point.Y - downRay.Position.Y) <= 12 then
        return downRay.Position + Vector3.new(0, 3, 0)
    end
    return nil
end


local function FindBestSpotAround(center, radius)
    local bestSpot = nil
    local bestHeight = -math.huge
    local steps = 16  
    for i = 0, steps-1 do
        local angle = (i / steps) * math.pi * 2
        local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local testPoint = center + offset
        local groundPoint = FindGroundBelow(testPoint)
        if groundPoint then
            if groundPoint.Y > bestHeight then
                bestHeight = groundPoint.Y
                bestSpot = groundPoint
            end
        end
    end
    return bestSpot
end


local function DoTeleport()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local origin = hrp.Position
    local forward = Camera.CFrame.LookVector
    local distance = Config.TeleportDistance
    
    
    local baseTarget = origin + forward * distance
    
    
    local bestSpot = nil
    for radius = 2, 8, 2 do
        bestSpot = FindBestSpotAround(baseTarget, radius)
        if bestSpot then break end
    end
    
    
    if not bestSpot then
        bestSpot = FindGroundBelow(baseTarget)
    end
    
    
    if not bestSpot then
        local newPos = origin + forward * distance
        hrp.CFrame = CFrame.new(newPos)
        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        print("[传送] 直线移动")
        return
    end
    
    
    local rise = bestSpot.Y - origin.Y
    if rise > 60 then
        bestSpot = Vector3.new(bestSpot.X, origin.Y + 60, bestSpot.Z)
        local groundCheck = FindGroundBelow(bestSpot)
        if groundCheck then bestSpot = groundCheck end
    end
    
    
    hrp.CFrame = CFrame.new(bestSpot)
    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
    local lookDir = Camera.CFrame.LookVector
    hrp.CFrame = CFrame.lookAt(bestSpot, bestSpot + lookDir)
    print("[传送] 环形扫描成功")
end


