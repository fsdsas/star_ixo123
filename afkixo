-- [ 模塊 3：智能探測底層攔截 (靜默瞄準) ] --------------------------------

State.SupportSilent = (type(hookmetamethod) == "function" and type(getnamecallmethod) == "function")

if State.SupportSilent then
    
    local success, err = pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if Config.isSilent and State.silentAimTarget and State.silentAimTarget:FindFirstChild("Head") then
                local targetPos = State.silentAimTarget.Head.Position
                
                if method == "Raycast" and self == workspace then
                    local origin = args[1]; local direction = args[2]
                    if typeof(direction) == "Vector3" and direction.Magnitude > 10 then
                        args[2] = (targetPos - origin).Unit * direction.Magnitude
                        return oldNamecall(self, unpack(args))
                    end
                end
                
                if method == "FireServer" then
                    local modified = false
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then args[i] = targetPos; modified = true end
                    end
                    if modified then return oldNamecall(self, unpack(args)) end
                end
            end
            return oldNamecall(self, ...)
        end)
    end)
    if not success then
        State.SupportSilent = false
        warn("[星輝系統] 執行器 hookmetamethod 異常，已自動隔離靜默功能。")
    end
else
    warn("[星輝系統] 您的執行器不支援底層攔截，靜默瞄準已停用。")
end

