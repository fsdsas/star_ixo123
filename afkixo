    local track = Instance.new("TextButton", frame); track.Size = UDim2.new(1, -30, 0, 6); track.Position = UDim2.new(0, 15, 0, 30); track.BackgroundColor3 = Color3.fromRGB(100, 100, 120); track.Text = ""; track.AutoButtonColor = false; Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", track); fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = Colors.Accent; Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
