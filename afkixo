local function adv_valid(p)
    if not p or p == LocalPlayer then return false end
    if LocalPlayer.Team and p.Team == LocalPlayer.Team then return false end
    local a = LocalPlayer:GetAttribute("TeamID"); local b = p:GetAttribute("TeamID")
    if a and b and a == b then return false end
    local c = p.Character; if not c then return false end
    local h = c:FindFirstChildWhichIsA("Humanoid"); if not h then return false end
    return h.Health > 0
end

local function adv_closest()
    local c = LocalPlayer.Character; if not c then return nil end
    local r = c:FindFirstChild("HumanoidRootPart"); if not r then return nil end
    local p = r.Position; local b, d = nil, math.huge
    for _, v in ipairs(Players:GetPlayers()) do
        if not adv_valid(v) then continue end
        local h = v.Character and v.Character:FindFirstChild("Head"); if not h then continue end
        local dist = (h.Position - p).Magnitude; if dist < d then d = dist; b = v end
    end
    return b
end

