_G.MyPhysicsLoop = RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart"); local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    
    if Config.isSpeed and hum.MoveDirection.Magnitude > 0 then
        hum.WalkSpeed = Config.SpeedValue
    end

    
    if Config.isWeapon then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and not State.appliedWeapons[tool.Name] then
            pcall(function()
                local info = tool:FindFirstChild("Info") or tool:FindFirstChild("Settings")
                if info then
                    for _, prop in pairs(info:GetChildren()) do
                        local name = prop.Name:lower()
                        if name:match("recoil") or name:match("spread") or name:match("cooldown") then
                            if prop:IsA("NumberValue") or prop:IsA("IntValue") then prop.Value = 0 end
                        elseif name:match("speed") and name:match("projectile") then
                            if prop:IsA("NumberValue") or prop:IsA("IntValue") then prop.Value = 999999 end
                        end
                    end
                    State.appliedWeapons[tool.Name] = true
                end
            end)
        end
    end

    if Config.isNoclip then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    
    if Config.isFly or Config.isMagnet or Config.isVoid then
        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.AssemblyAngularVelocity = Vector3.new(0,0,0) end end
    end

    if Config.isVoid then
        if not State.hasSavedCFrame then State.safeCFrame = hrp.CFrame; State.hasSavedCFrame = true end
        hrp.CFrame = CFrame.new(voidPlatforms[1] + Vector3.new(0, 5, 0)); hrp.AssemblyLinearVelocity = Vector3.new(0,0,0); return
    else
        if State.hasSavedCFrame and State.safeCFrame then hrp.CFrame = State.safeCFrame; State.hasSavedCFrame = false end
    end

    if Config.isMagnet then
        local enemy = getClosestEnemy() 
        if enemy and enemy:FindFirstChild("HumanoidRootPart") then
            local tHrp = enemy.HumanoidRootPart
            if Config.MagnetMode == "Above" then hrp.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, Config.MagnetDistance, 0)) else hrp.CFrame = CFrame.new(tHrp.Position + (tHrp.CFrame.LookVector * -Config.MagnetDistance)) end
            hrp.CFrame = CFrame.lookAt(hrp.Position, tHrp.Position); hrp.AssemblyLinearVelocity = Vector3.new(0,0,0); return
        end
    end

    if Config.isFly then
        local md = Vector3.new(0,0,0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then md = md + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then md = md - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then md = md - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then md = md + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then md = md - Vector3.new(0,1,0) end
        if hum.MoveDirection.Magnitude > 0 then md = md + hum.MoveDirection end
        hrp.AssemblyLinearVelocity = md.Magnitude > 0 and (md.Unit * Config.FlySpeed) or Vector3.new(0,0,0)
    end
end)

