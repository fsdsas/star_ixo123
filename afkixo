local function toggleIgnoreTarget()
    local centerPos = Camera.ViewportSize / 2; local closestChar, shortestDist = nil, AIMBOT_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - centerPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestChar = p.Character end
                end
            end
        end
    end
    if closestChar then
        local p = Players:GetPlayerFromCharacter(closestChar)
        if p then 
            ignoredPlayers[p.UserId] = not ignoredPlayers[p.UserId] 
            if ignoredPlayers[p.UserId] then btnZ.Text = "保護中: " .. p.Name; btnZ.BackgroundColor3 = Color3.fromRGB(50, 180, 50) 
            else btnZ.Text = "已移除: " .. p.Name; btnZ.BackgroundColor3 = Color3.fromRGB(180, 50, 50) end
            task.delay(1.5, function() btnZ.Text = "Z : 標記準心目標"; btnZ.BackgroundColor3 = Color3.fromRGB(80, 80, 80) end)
        end
    end
end

local function isValidTarget(char, requireOnScreen)
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or ignoredPlayers[p.UserId] then return false end
    if requireOnScreen then return select(2, Camera:WorldToViewportPoint(root.Position)) end
    return true
end

local function getClosestToCenter()
    local centerPos = Camera.ViewportSize / 2; local closestChar, shortestDist = nil, AIMBOT_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not ignoredPlayers[p.UserId] then
            local root = p.Character:FindFirstChild("HumanoidRootPart"); local hum = p.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - centerPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestChar = p.Character end
                end
            end
        end
    end
    return closestChar
end

local function getClosestEnemy()
    local closestDist, closestChar = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not ignoredPlayers[p.UserId] then
            local root = p.Character:FindFirstChild("HumanoidRootPart"); local hum = p.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - Camera.CFrame.Position).Magnitude
                if dist < closestDist then closestDist = dist; closestChar = p.Character end
            end
        end
    end
    return closestChar
end


