local function updatePhysicsState()
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if hum and hum.Health > 0 then
       
        if isFlying or isMagnetActive or isHitAndRunActive or isAttacking then 
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        else 
            hum:ChangeState(Enum.HumanoidStateType.GettingUp) 
        end
    end
end

local function toggleNoclip()
    isNoclip = not isNoclip
    if not isNoclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end
    end
end

