                local p = Players:GetPlayerFromCharacter(char)
                if p and not ignoredPlayers[p.UserId] and char.Humanoid.Health > 0 then
                    if tick() - lastClickTime > TRIGGER_DELAY then
                        lastClickTime = tick()
                        if mouse1click then pcall(function() mouse1click() end) end
                    end
                end
            end
        end
    end
end)


local function toggleFlingAura()
    isFlingAuraActive = not isFlingAuraActive
    local char = LocalPlayer.Character
    if not char then return end
    if isFlingAuraActive then
        flingLimbs = {}
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "Head" and part.Name ~= "Torso" and part.Name ~= "UpperTorso" then
                for _, joint in ipairs(part:GetDescendants()) do if joint:IsA("Motor6D") or joint:IsA("Weld") then joint.Part0 = nil end end
                part.CanCollide = true; table.insert(flingLimbs, part)
            end
        end
    else flingLimbs = {} end
end

