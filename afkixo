_G.MyActionBtns = UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.Z then toggleIgnoreTarget()
    elseif key == Enum.KeyCode.X then toggleNoclip()
    elseif key == Enum.KeyCode.C then isFlying = not isFlying; updatePhysicsState()
    elseif key == Enum.KeyCode.V then isMagnetActive = not isMagnetActive; updatePhysicsState()
    elseif key == Enum.KeyCode.F then isAimbotActive = not isAimbotActive
    elseif key == Enum.KeyCode.H then mainFrame.Visible = true 
    end
    updateUI()
end)

