local sliderConnections = {}
local function createSlider(name, minVal, maxVal, currentVal, yPos, callback)
    local container = Instance.new("Frame", scrollFrame)
    container.Size = UDim2.new(1, -20, 0, 40); container.Position = UDim2.new(0, 10, 0, yPos); container.BackgroundTransparency = 1
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(1, 0, 0, 15); label.BackgroundTransparency = 1; label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold; label.TextSize = 12; label.Text = name .. ": " .. tostring(currentVal); label.TextXAlignment = Enum.TextXAlignment.Left
    local track = Instance.new("TextButton", container)
    track.Size = UDim2.new(1, 0, 0, 15); track.Position = UDim2.new(0, 0, 0, 20); track.BackgroundColor3 = Color3.fromRGB(50, 50, 50); track.Text = ""; track.AutoButtonColor = false
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((currentVal - minVal) / (maxVal - minVal), 0, 1, 0); fill.BackgroundColor3 = Color3.fromRGB(0, 255, 255); fill.BorderSizePixel = 0
    local dragging = false
    local function updateSlider(input)
        local mouseX = input.Position.X; local percent = math.clamp((mouseX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(percent, 0, 1, 0); local val = math.floor(minVal + (maxVal - minVal) * percent)
        label.Text = name .. ": " .. tostring(val); callback(val)
    end
    track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; updateSlider(input) end end)
    track.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    local conn = UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end end)
    table.insert(sliderConnections, conn); return container
end
_G.MySliderCleaner = function() for _, conn in ipairs(sliderConnections) do conn:Disconnect() end end

