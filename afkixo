-- [ 目标检测系统 ]
local function isVisible(targetPart)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, rayParams)
    if result then return result.Instance:IsDescendantOf(targetPart.Parent) end
    return true
end

local function isValidTarget(char)
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid"); local head = char:FindFirstChild("Head")
    if not hum or not head or hum.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or State.ignoredPlayers[p.UserId] then return false end
    local _, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen then return false end
    return isVisible(head)
end

local function getClosestToCenter()
    local centerPos = Camera.ViewportSize / 2; local closestChar, shortestDist = nil, Config.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not State.ignoredPlayers[p.UserId] then
            local head = p.Character:FindFirstChild("Head"); local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and isVisible(head) then
                    local dist = (Vector2.new(pos.X, pos.Y) - centerPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestChar = p.Character end
                end
            end
        end
    end
    return closestChar
end

local function getClosestEnemy()
    local closestDist, closestChar = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not State.ignoredPlayers[p.UserId] then
            local root = p.Character:FindFirstChild("HumanoidRootPart"); local hum = p.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - Camera.CFrame.Position).Magnitude
                if dist < closestDist then closestDist = dist; closestChar = p.Character end
            end
        end
    end
    return closestChar
end

-- [ 自瞄与扳机 ]
_G.MyTargetCacheLoop = RunService.RenderStepped:Connect(function()
    if Config.isFullBright then Lighting.ClockTime = 12; Lighting.FogEnd = 100000; Lighting.GlobalShadows = false; Lighting.Ambient = Color3.fromRGB(255, 255, 255) end
    if FOVCircle then FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) end

    if Config.isAimbot then
        if not isValidTarget(State.silentAimTarget) then State.silentAimTarget = getClosestToCenter() end
        if State.silentAimTarget and State.silentAimTarget:FindFirstChild("Head") then
            if math.random(1, 100) <= Config.HeadshotChance then State.currentAimPart = "Head" else State.currentAimPart = "HumanoidRootPart" end
            local headPos = State.silentAimTarget.Head.Position
            local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen and DriftCircle then
                DriftCircle.Visible = true; DriftCircle.Position = Vector2.new(screenPos.X, screenPos.Y); DriftCircle.Radius = Config.DriftRadius
            elseif DriftCircle then DriftCircle.Visible = false end
            if tick() - State.driftTimer > 0.05 then
                State.driftTimer = tick()
                local r = math.random() * Config.DriftRadius; local theta = math.random() * math.pi * 2
                State.targetDrift = Vector2.new(r * math.cos(theta), r * math.sin(theta))
            end
            State.driftOffset = State.driftOffset:Lerp(State.targetDrift, 0.4)
        else
            if DriftCircle then DriftCircle.Visible = false end
        end
    else
        State.silentAimTarget = nil; if DriftCircle then DriftCircle.Visible = false end
    end
end)

RunService:BindToRenderStep("MyMouseAimLoop", Enum.RenderPriority.Last.Value, function()
    if Config.isAimbot and State.silentAimTarget and State.silentAimTarget:FindFirstChild(State.currentAimPart) then
        local targetPartPos = State.silentAimTarget[State.currentAimPart].Position
        local targetPos, onScreen = Camera:WorldToViewportPoint(targetPartPos)
        if onScreen then
            local finalTarget2D = Vector2.new(targetPos.X, targetPos.Y) + State.driftOffset
            if mousemoverel and not isMobile then
                local center = Camera.ViewportSize / 2
                local moveX = (finalTarget2D.X - center.X) / Config.Smoothness; local moveY = (finalTarget2D.Y - center.Y) / Config.Smoothness
                pcall(function() mousemoverel(moveX + math.random(-1,1)*0.2, moveY + math.random(-1,1)*0.2) end)
            else
                local dist = (targetPartPos - Camera.CFrame.Position).Magnitude
                local ray = Camera:ScreenPointToRay(finalTarget2D.X, finalTarget2D.Y)
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, ray.Origin + ray.Direction * dist), 1 / (Config.Smoothness * 0.5))
            end
        end
    end

    if Config.isTriggerBot then
        local t = Mouse.Target
        if t and t.Parent then
            local char = t:FindFirstAncestorOfClass("Model")
            if char and char:FindFirstChild("Humanoid") and char ~= LocalPlayer.Character and not State.ignoredPlayers[Players:GetPlayerFromCharacter(char) and Players:GetPlayerFromCharacter(char).UserId] then
                if tick() - State.lastClickTime > Config.TriggerDelay then
                    State.lastClickTime = tick()
                    if mouse1click then pcall(mouse1click) end
                end
            end
        end
    end
end)

