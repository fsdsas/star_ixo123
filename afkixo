local function isValidTarget(char, requireOnScreen)
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid"); local head = char:FindFirstChild("Head")
    if not hum or not head or hum.Health <= 0 then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or ignoredPlayers[p.UserId] then return false end
    if requireOnScreen then
        local _, onScreen = Camera:WorldToViewportPoint(head.Position)
        return onScreen
    end
    return true
end

local function getClosestToCenter()
    local centerPos = Camera.ViewportSize / 2; local closestChar, shortestDist = nil, AIMBOT_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not ignoredPlayers[p.UserId] then
            local head = p.Character:FindFirstChild("Head"); local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - centerPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestChar = p.Character end
                end
            end
        end
    end
    return closestChar
end

local function getClosestEnemy()
    local closestDist, closestChar = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not ignoredPlayers[p.UserId] then
            local head = p.Character:FindFirstChild("Head"); local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (head.Position - Camera.CFrame.Position).Magnitude
                if dist < closestDist then closestDist = dist; closestChar = p.Character end
            end
        end
    end
    return closestChar
end

_G.MyTargetCacheLoop = RunService.RenderStepped:Connect(function()
    if FOVCircle then FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) end
    if isAimbotActive then
        if not isValidTarget(silentAimTarget, true) then silentAimTarget = getClosestToCenter() end
    else silentAimTarget = nil end
end)

RunService:BindToRenderStep("MyMouseAimLoop", Enum.RenderPriority.Camera.Value + 1, function()
    if isAimbotActive and silentAimTarget and silentAimTarget:FindFirstChild("Head") then
        local targetPos, onScreen = Camera:WorldToViewportPoint(silentAimTarget.Head.Position)
        if onScreen then
            local center = Camera.ViewportSize / 2
            local moveX = (targetPos.X - center.X) / AIM_SMOOTHNESS
            local moveY = (targetPos.Y - center.Y) / AIM_SMOOTHNESS
            moveX = moveX + math.random(-1, 1) * 0.2; moveY = moveY + math.random(-1, 1) * 0.2
            if mousemoverel then pcall(function() mousemoverel(moveX, moveY) end) end
        end
    end

    if isTriggerBotActive then
        local target = Mouse.Target
        if target and target.Parent then
            local char = target:FindFirstAncestorOfClass("Model")
            if char and char:FindFirstChild("Humanoid") and char ~= LocalPlayer.Character then
                local p = Players:GetPlayerFromCharacter(char)
                if p and not ignoredPlayers[p.UserId] and char.Humanoid.Health > 0 then
                    if tick() - lastClickTime > TRIGGER_DELAY then
                        lastClickTime = tick()
                        if mouse1click then pcall(function() mouse1click() end) end
                    end
                end
            end
        end
    end
end)

_G.MyPhysicsLoop = RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    if isNoclip then for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end end
    if not isFlying and not isMagnetActive and not isHitAndRunActive then
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.AssemblyAngularVelocity = Vector3.new(0,0,0) end end
    end

    if isHitAndRunActive then
        if not hasSavedCFrame then safeCFrame = hrp.CFrame; hasSavedCFrame = true end
        if isAttacking then
            local target = silentAimTarget
            if not isValidTarget(target, false) then target = getClosestEnemy() end
            if target and target:FindFirstChild("Head") then
                hrp.CFrame = CFrame.new(target.Head.Position + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
            else hrp.CFrame = CFrame.new(voidPlatforms[1] + Vector3.new(0, 5, 0)) end
        else 
            hrp.CFrame = CFrame.new(voidPlatforms[math.floor(os.clock() * 8) % 4 + 1] + Vector3.new(0, 5, 0)) 
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0); return
    else
        if hasSavedCFrame then if safeCFrame then hrp.CFrame = safeCFrame end; hasSavedCFrame = false end
    end

    if isMagnetActive then
        local targetEnemy = getClosestEnemy() 
        if targetEnemy and targetEnemy:FindFirstChild("HumanoidRootPart") and targetEnemy.Humanoid.Health > 0 then
            local targetHrp = targetEnemy.HumanoidRootPart
            if (targetHrp.Position - hrp.Position).Magnitude <= MAX_ATTACK_RANGE then
                local targetPoint = targetHrp.Position + (targetHrp.CFrame.LookVector * -BEHIND_OFFSET)
                hrp.CFrame = CFrame.new(targetPoint)
                hrp.CFrame = CFrame.lookAt(hrp.Position, targetHrp.Position)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0); return 
            end
        end
        isMagnetActive = false; hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) 
        task.defer(function() updatePhysicsState(); updateUI() end) 
    end

    if isFlying then
        local moveDir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        local thumbstickDir = hum.MoveDirection
        if thumbstickDir.Magnitude > 0 then moveDir = moveDir + thumbstickDir end
        hrp.AssemblyLinearVelocity = moveDir.Magnitude > 0 and (moveDir.Unit * FLY_SPEED) or Vector3.new(0, 0, 0) 
    end
end)

