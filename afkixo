    label.BackgroundTransparency = 1; label.Text = text .. (hotkeyInfo and (" ["..hotkeyInfo.."]") or "")
    label.Font = Enum.Font.GothamBold; label.TextSize = 13; label.TextColor3 = Colors.TextMain; label.TextXAlignment = Enum.TextXAlignment.Left
    local toggleBtn = Instance.new("TextButton", frame)
    toggleBtn.Size = UDim2.new(0, 40, 0, 20); toggleBtn.Position = UDim2.new(1, -55, 0.5, -10)
    toggleBtn.BackgroundColor3 = defaultState and Colors.ToggleOn or Colors.ToggleOff; toggleBtn.Text = ""
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(1, 0)
    local circle = Instance.new("Frame", toggleBtn)
    circle.Size = UDim2.new(0, 16, 0, 16); circle.Position = UDim2.new(defaultState and 1 or 0, defaultState and -18 or 2, 0.5, -8)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
    local state = defaultState
    local function fireToggle()
        state = not state; callback(state)
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = state and Colors.ToggleOn or Colors.ToggleOff}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(state and 1 or 0, state and -18 or 2, 0.5, -8)}):Play()
    end
    toggleBtn.MouseButton1Click:Connect(fireToggle)
    return function(newState) if state ~= newState then fireToggle() end end
end

local function CreateSlider(parent, text, min, max, default, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -10, 0, 50); frame.BackgroundColor3 = Color3.fromRGB(20, 20, 40); frame.BackgroundTransparency = 0.5
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -20, 0, 20); label.Position = UDim2.new(0, 15, 0, 5)
    label.BackgroundTransparency = 1; label.Text = text .. " : " .. default
    label.Font = Enum.Font.GothamBold; label.TextSize = 12; label.TextColor3 = Colors.TextMain; label.TextXAlignment = Enum.TextXAlignment.Left
    local track = Instance.new("TextButton", frame)
    track.Size = UDim2.new(1, -30, 0, 6); track.Position = UDim2.new(0, 15, 0, 30)
    track.BackgroundColor3 = Color3.fromRGB(100, 100, 120); track.Text = ""; track.AutoButtonColor = false
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = Colors.Accent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local dragging = false
    local function update(input)
        local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        local val = math.floor(min + (max - min) * pct)
        label.Text = text .. " : " .. val; callback(val)
    end
    track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end end)
    track.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
end

