                    end)
                end
                task.wait(0.1)
            end
            
            local h = t.Character:FindFirstChild("Head"); if not h then return unpack(r) end
            local hp = h.Position; local fo = hp - Vector3.new(0, 5, 0); local ld = CFrame.lookAt(fo, hp)
            local ro = h.CFrame:ToObjectSpace(CFrame.new(hp + Vector3.new(math.random(), math.random(), math.random())))
