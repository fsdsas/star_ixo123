_G.MyESPLoop = RunService.Heartbeat:Connect(function()
    pcall(function()
        for _, espNode in ipairs(chamsFolder:GetChildren()) do
            local p = Players:FindFirstChild(espNode.Name)
            if not p or ignoredPlayers[p.UserId] or not p.Character or not p.Character:FindFirstChild("Humanoid") or p.Character.Humanoid.Health <= 0 then 
                espNode:Destroy() 
                local oldGui = screenGui:FindFirstChild("ToolESP_" .. espNode.Name)
                if oldGui then oldGui:Destroy() end
            end
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local char = p.Character
            
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and not ignoredPlayers[p.UserId] then
                local hrp = char.HumanoidRootPart
                local espNode = chamsFolder:FindFirstChild(p.Name)
                
                -- 透視框顏色：跟隨隊伍色 (預設紅色)
                local espColor = Color3.fromRGB(255, 0, 0) 
                if p.Team then espColor = p.TeamColor.Color end
                
                
                if not espNode then
                    espNode = Instance.new("Folder", chamsFolder); espNode.Name = p.Name
                    local box = Instance.new("BoxHandleAdornment", espNode)
                    box.Name = "BoundingBox"; box.Adornee = hrp; box.AlwaysOnTop = true; box.ZIndex = 10
                    box.Size = Vector3.new(4, 5.5, 2); box.Transparency = 0.6; box.Color3 = espColor
                else
                    local box = espNode:FindFirstChild("BoundingBox")
                    if box then 
                        if box.Adornee ~= hrp then box.Adornee = hrp end
                        box.Color3 = espColor
                    end
                end
                
                -- 繪製 2D 獨立面板 (顯示名稱與武器)
                local toolGui = screenGui:FindFirstChild("ToolESP_" .. p.Name)
                if not toolGui then
                    toolGui = Instance.new("BillboardGui", screenGui)
                    toolGui.Name = "ToolESP_" .. p.Name
                    toolGui.Size = UDim2.new(0, 250, 0, 50) 
                    toolGui.StudsOffset = Vector3.new(0, 3.5, 0)
                    toolGui.AlwaysOnTop = true
                    toolGui.MaxDistance = math.huge 
                    
                    local txt = Instance.new("TextLabel", toolGui)
                    txt.Name = "Label"; txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.GothamBold; txt.TextSize = 12
                    txt.RichText = true 
                    txt.Text = ""
                end
                
                if toolGui.Adornee ~= hrp then toolGui.Adornee = hrp end
                local txt = toolGui:FindFirstChild("Label")
                if txt then
                    
                    local displayName = p.DisplayName
                    local nameColor = "#FFFFFF" -- 名稱：白色高對比
                    local toolStr = ""
                    
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then 
                        toolStr = '<font color="#00FFFF">[ ' .. tool.Name .. ' ]</font>' 
                    else 
                        local backpack = p:FindFirstChild("Backpack")
                        local hiddenTools = {}
                        if backpack then
                            for _, item in ipairs(backpack:GetChildren()) do
                                if item:IsA("Tool") then table.insert(hiddenTools, item.Name) end
                            end
                        end
                        
                        if #hiddenTools > 0 then
                            if #hiddenTools > 2 then
                                toolStr = '<font color="#FFA500">[ ' .. hiddenTools[1] .. ', ' .. hiddenTools[2] .. '... ]</font>' 
                            else
                                toolStr = '<font color="#FFA500">[ ' .. table.concat(hiddenTools, ", ") .. ' ]</font>'
                            end
                        else
                            toolStr = '<font color="#888888">[ 空手 ]</font>' -- 空手：低調灰
                        end
                    end
                    
                    txt.Text = string.format('<font color="%s">%s</font>\n%s', nameColor, displayName, toolStr)
                end
            end
        end
    end)
end)

